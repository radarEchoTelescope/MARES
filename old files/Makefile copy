SRC_DIR := src
OBJ_DIR := obj
# BIN_DIR := . 
BIN_DIR := bin

# Executable name
EXE := $(BIN_DIR)/$(TARGET)
# List source files
SRC := $(wildcard $(SRC_DIR)/*.c)
# From source, list object files
OBJ := $(SRC:$(SRC_DIR)/%.c=$(OBJ_DIR)/%.o)

#DIR= ../IceRayTracing/namespace/woROOT/

# FLAGS
CC = g++
# C PreProcessor flags
CPPFLAGS = -Iinclude -MMD -MP #-I$(DIR)
# -MMD -MP generate the header dependencies automatically
CFLAGS =  -O -g #-Wall
# -O performs optimizations, -g enables debugging, -Wall are warnings
# LDFLAGS  := -Llib              # -L is a linker flag
# LDLIBS= -lgsl -lgslcblas

.PHONY :  all clean

all: $(EXE)

$(EXE): $(OBJ) | $(BIN_DIR)
	$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c | $(OBJ_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BIN_DIR) $(OBJ_DIR):
	mkdir -p $@


